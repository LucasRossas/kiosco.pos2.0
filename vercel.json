{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/mercadopago-oauth-state",
      "destination": "/api/mp-auth"
    },
    {
      "source": "/api/mercadopago-callback",
      "destination": "/api/mp-auth"
    },
    {
      "source": "/api/mercadopago-disconnect",
      "destination": "/api/mp-auth?action=disconnect"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
