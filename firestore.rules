rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsTenant(tenantId) {
      return isAuthenticated() && request.auth.uid == tenantId;
    }

    function documentMatchesTenant(tenantId) {
      return !request.resource.data.keys().hasAny(['tenantId'])
        || request.resource.data.tenantId == tenantId;
    }

    function isPendingAccount() {
      return (!request.resource.data.keys().hasAny(['isActive'])
        || request.resource.data.isActive == false)
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status == 'pending_payment');
    }

    function canUpdateSubscriptionMetadata() {
      return false;
    }

    match /users/{userId} {
      allow read, delete: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && documentMatchesTenant(userId)
        && isPendingAccount();
      allow update: if ownsUser(userId)
        && documentMatchesTenant(userId)
        && canUpdateSubscriptionMetadata();
    }

    match /tenants/{tenantId} {
      allow read, delete: if ownsTenant(tenantId);
      allow create: if ownsTenant(tenantId)
        && documentMatchesTenant(tenantId)
        && isPendingAccount();
      allow update: if ownsTenant(tenantId)
        && documentMatchesTenant(tenantId)
        && canUpdateSubscriptionMetadata();

      match /{documentPath=**} {
        allow read, delete: if ownsTenant(tenantId);
        allow create, update: if ownsTenant(tenantId) && documentMatchesTenant(tenantId);
      }
    }

    match /global_products/{productId} {
      allow read, write: if false;
    }

    match /{documentPath=**} {
      allow read, write: if false;
    }
  }
}
